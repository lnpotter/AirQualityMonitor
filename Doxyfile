PROJECT_NAME = "Air Quality Monitor"
PROJECT_BRIEF = "Portable C application for collecting, storing, and analyzing air quality sensor readings"
OUTPUT_LANGUAGE = English

INPUT = include src plugins README.md
RECURSIVE = YES
FILE_PATTERNS = *.c *.h
USE_MDFILE_AS_MAINPAGE = README.md

EXCLUDE = tests
EXTRACT_ALL = NO
EXTRACT_STATIC = YES
EXTRACT_LOCAL_METHODS = YES
HIDE_UNDOC_MEMBERS = YES
HIDE_UNDOC_CLASSES = YES

JAVADOC_AUTOBRIEF = YES
OUTPUT_DIRECTORY = docs/api
GENERATE_HTML = YES
GENERATE_LATEX = NO
HTML_OUTPUT = html
GENERATE_TREEVIEW = YES
SOURCE_BROWSER = YES

ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = YES
PREDEFINED = HAVE_HPDF

# No Graphviz dependency required: HAVE_DOT off keeps `doxygen Doxyfile`
# working with zero extra installs. Flip to YES if graphviz is available
# and you want include/collaboration graphs.
HAVE_DOT = NO
QUIET = NO
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = YES
